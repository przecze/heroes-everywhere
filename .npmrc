# The supply-chain rules for every npm run in this repo: the owner's Mac, the cloud threads, the server's image build
# (docs/supply-chain.md). tools/deps/check.ts (in npm test) fails when one of these goes.
# No package's install scripts ever run (esbuild and protobufjs had them; both work without).
ignore-scripts=true
# A new version waits a week before npm takes it (npm 11.10 or later; older ones ignore it, the gate's check doesn't).
min-release-age=7
# Exact versions, never ranges, when a package is added.
save-exact=true
# Only the registry: no dependencies from git.
allow-git=none
fund=false
